# -----------------------------------------------------------------------------
# Vegetable POS Central Backend API — Environment Configuration Template
# Production Host: https://api.sudoleads.com
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (VPS PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=pos_user
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=sabzi_mandi_dashboard

# PostgreSQL Connection Pool Settings
DB_MAX_CLIENTS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# CORS & Frontend Origins
CORS_ORIGIN=https://pos.sudoleads.com
FRONTEND_URL=https://pos.sudoleads.com
DASHBOARD_URL=https://pos.sudoleads.com
POS_URL=http://localhost:8000

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# SMTP Configuration (Brevo / Sendinblue or other SMTP Provider)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_or_api_key_here
SMTP_FROM="Vegetable POS <noreply@sudoleads.com>"
SMTP_FROM_NAME="Vegetable POS"
