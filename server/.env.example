PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=sabzi_mandi_dashboard

# Connection Pool Settings
DB_MAX_CLIENTS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Set real SMTP credentials to enable automated invitation dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vegetable POS <noreply@sudoleads.com>"


# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
